# The rules godesign's code keeps on every change.
#
# A plan in design/ describes one change and is retired once it is merged. This
# file is not: "godesign invariants" checks the code against it whenever either
# one changes, and "godesign plan" checks every plan against it before the code
# is written. Change a rule here first, with a reason, and the code after it.
#
# The code supplies the facts: which packages there are, and what each imports.
# The ClassAssertions below put packages in groups. Every other logical axiom is
# a rule, checked over those facts under the closed-world assumption: what the
# code does not do, it does not do. An rdfs:comment on a rule says why it
# exists, and is what a broken rule is reported by.
#
# gowl's packages are external here: godesign uses gowl the way any other
# program does, through its public packages and at a released version.

Prefix(:=<https://github.com/LukasSelin/godesign#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

Ontology(<https://github.com/LukasSelin/godesign/design/invariants>

    # The words gocode describes the code with.
    Declaration(Class(:Package))
    Declaration(Class(:ExternalPackage))
    Declaration(ObjectProperty(:imports))

    # Groups.
    Declaration(Class(:Internal))
    AnnotationAssertion(rdfs:comment :Internal "Packages only godesign's own command uses.")
    Declaration(Class(:Tool))
    AnnotationAssertion(rdfs:comment :Tool "Commands and examples: programs, at the edge.")
    Declaration(Class(:Pure))
    AnnotationAssertion(rdfs:comment :Pure "Internal packages that do no I/O of their own.")
    Declaration(Class(:Effectful))
    AnnotationAssertion(rdfs:comment :Effectful "Standard library packages that reach outside the process: files, processes, the network, logs.")

    Declaration(ObjectProperty(:dependsOn))
    AnnotationAssertion(rdfs:comment :dependsOn "Imports, followed any distance.")
    SubObjectPropertyOf(:imports :dependsOn)
    TransitiveObjectProperty(:dependsOn)

    Declaration(NamedIndividual(:package.github.com.LukasSelin.godesign.internal.gocode))
    Declaration(NamedIndividual(:package.github.com.LukasSelin.godesign.internal.icv))
    Declaration(NamedIndividual(:package.github.com.LukasSelin.godesign.internal.designgate))
    Declaration(NamedIndividual(:package.github.com.LukasSelin.godesign.internal.ontologycheck))
    ClassAssertion(:Internal :package.github.com.LukasSelin.godesign.internal.gocode)
    ClassAssertion(:Internal :package.github.com.LukasSelin.godesign.internal.icv)
    ClassAssertion(:Internal :package.github.com.LukasSelin.godesign.internal.designgate)
    ClassAssertion(:Internal :package.github.com.LukasSelin.godesign.internal.ontologycheck)
    ClassAssertion(:Pure :package.github.com.LukasSelin.godesign.internal.icv)

    Declaration(NamedIndividual(:package.github.com.LukasSelin.godesign.cmd.godesign))
    Declaration(NamedIndividual(:package.github.com.LukasSelin.godesign.examples.self))
    ClassAssertion(:Tool :package.github.com.LukasSelin.godesign.cmd.godesign)
    ClassAssertion(:Tool :package.github.com.LukasSelin.godesign.examples.self)

    Declaration(NamedIndividual(:package.os))
    Declaration(NamedIndividual(:package.os.exec))
    Declaration(NamedIndividual(:package.os.signal))
    Declaration(NamedIndividual(:package.net))
    Declaration(NamedIndividual(:package.net.http))
    Declaration(NamedIndividual(:package.syscall))
    Declaration(NamedIndividual(:package.log))
    Declaration(NamedIndividual(:package.database.sql))
    ClassAssertion(:Effectful :package.os)
    ClassAssertion(:Effectful :package.os.exec)
    ClassAssertion(:Effectful :package.os.signal)
    ClassAssertion(:Effectful :package.net)
    ClassAssertion(:Effectful :package.net.http)
    ClassAssertion(:Effectful :package.syscall)
    ClassAssertion(:Effectful :package.log)
    ClassAssertion(:Effectful :package.database.sql)

    # Rules.

    SubClassOf(Annotation(rdfs:comment "Every package is in a group on purpose, so a new one is added here before it is written")
        :Package ObjectUnionOf(:Internal :Tool))

    DisjointClasses(Annotation(rdfs:comment "The pure internal packages do no I/O: effects stay at the edges, in the tools, the hooks and gocode")
        :Pure ObjectSomeValuesFrom(:dependsOn :Effectful))

    SubClassOf(Annotation(rdfs:comment "The invariant checker is the trusted core, so it stays small: gowl's owl package and the standard library, and nothing of godesign's")
        ObjectOneOf(:package.github.com.LukasSelin.godesign.internal.icv) ObjectAllValuesFrom(:imports :ExternalPackage))
)
